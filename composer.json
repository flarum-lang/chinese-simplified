{
	"name": "flarum-lang/chinese-simplified",
	"description": "Chinese (Simplified) Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/chinese-simplified",
	"license": "MIT",
	"authors": [
		{
			"name": "thatsgolden",
			"homepage": "https://github.com/thatsgolden",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/chinese-simplified/issues",
		"forum": "https://discuss.flarum.org/d/22690",
		"source": "https://github.com/flarum-lang/chinese-simplified"
	},
	"require": {
		"flarum/core": "^1.0.0"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		},
		"flarum-extension": {
			"title": "Chinese (Simplified)",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#fff",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "zh-Hans",
			"title": "简体中文"
		}
	}
}
