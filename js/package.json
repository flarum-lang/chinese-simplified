{
    "name": "@flarum-lang/chinese-simplified",
    "version": "0.0.0",
    "private": true,
    "dependencies": {
        "flarum-webpack-config": "^3.0.4",
        "webpack": "^5.65.0",
        "webpack-cli": "^4.9.1",
        "webpack-merge": "^5.10.0"
    },
    "devDependencies": {
        "@types/mithril": "^2.2.0",
        "flarum-tsconfig": "^2.0.0",
        "oxfmt": "^0.66.0",
        "typescript": "^5.0.0"
    },
    "scripts": {
        "dev": "webpack --mode development --watch",
        "build": "webpack --mode production",
        "build-typings": "tsc --emitDeclarationOnly",
        "check-typings": "tsc --noEmit --emitDeclarationOnly false",
        "format": "cd .. && oxfmt --config js/.oxfmtrc.json js less",
        "format-check": "cd .. && oxfmt --config js/.oxfmtrc.json --check js less"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.8.1"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "12.8.1"
        }
    }
}
